meta {
  name: Token holen (user)
  type: http
  seq: 3
}

post {
  url: {{keycloakTokenUrl}}
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{keycloakClientId}}
  username: user
  password: {{keycloakTestPassword}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() !== 200 || !body.access_token) {
    throw new Error("Keycloak lieferte keinen User-Token");
  }
  bru.setEnvVar("userToken", body.access_token);
}
