APP_NAME=Soldat-Backend
DATABASE_URL=postgresql+asyncpg://soldat:p@localhost:5432/soldat
DB_SSL=true
DB_SSL_VERIFY=false
DB_SSL_CERT=extras/postgres/init/tls/server.crt
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/soldat
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/soldat/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=soldat-api
KEYCLOAK_AUDIENCE=soldat-api
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/soldat/protocol/openid-connect/token

