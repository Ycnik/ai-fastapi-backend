{
  "realm": "soldat",
  "enabled": true,
  "displayName": "Soldat (Entwicklung)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Darf Soldaten lesen und ändern"
      },
      {
        "name": "user",
        "description": "Darf Soldaten lesen"
      }
    ]
  },
  "clients": [
    {
      "clientId": "soldat-api",
      "name": "Soldat API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "none",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "soldat-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "soldat-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "firstName": "Lokaler",
      "lastName": "Administrator",
      "enabled": true,
      "email": "admin@soldat.local",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "p",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "user",
      "firstName": "Lokaler",
      "lastName": "Benutzer",
      "enabled": true,
      "email": "user@soldat.local",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "p",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
